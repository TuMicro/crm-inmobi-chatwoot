<%
  # [turuta] Misma logica que en Chatwoot; los textos salen de
  # config/locales/turuta.*.yml en vez de estar escritos aqui en ingles.
  brand_name = global_config['BRAND_NAME'] || 'Chatwoot'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?
  base = 'turuta.mail.confirmation'

  caso = 'welcome'
  action_url = frontend_url('auth/confirmation', confirmation_token: @token)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << [t("#{base}.new_email"), @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    caso = 'email_update'
  elsif @resource.confirmed?
    caso = 'ready'
    action_url = frontend_url('auth/sign_in')
    detail_rows = []
  elsif invited_user
    caso = 'invitation'
    action_url = frontend_url(
      'auth/password/edit',
      reset_password_token: @resource.send(:set_reset_password_token)
    )
    detail_rows = [[t("#{base}.invited_by"), inviter.name]]
    detail_rows << [t("#{base}.workspace"), account_name] if account_name.present?
  end

  eyebrow = t("#{base}.#{caso}.eyebrow")
  supporting_text = t("#{base}.#{caso}.supporting")
  action_text = t("#{base}.#{caso}.action")
  if caso == 'invitation'
    variante = account_name.present? ? 'account' : 'brand'
    heading = t("#{base}.invitation.heading_#{variante}", account: account_name, brand: brand_name)
    intro_text = t("#{base}.invitation.intro_#{variante}", inviter: inviter.name, account: account_name, brand: brand_name)
  else
    heading = t("#{base}.#{caso}.heading")
    intro_text = t("#{base}.#{caso}.intro", brand: brand_name)
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
